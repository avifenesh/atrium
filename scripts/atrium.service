[Unit]
Description=atrium life dashboard

[Service]
# node is nvm-managed; systemd user PATH won't have it, so use the absolute path
ExecStart=/home/avifenesh/.nvm/versions/node/v25.9.0/bin/node /home/avifenesh/projects/atrium/server/dist/server/src/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# collectors shell out to node (revuto cli), hermes (~/.local/bin), gh/ss/ps — none on the default systemd user PATH
Environment=PATH=/home/avifenesh/.nvm/versions/node/v25.9.0/bin:/home/avifenesh/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
