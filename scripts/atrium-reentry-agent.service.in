[Unit]
Description=Atrium Re-entry status preparation (Grok 4.6)
After=atrium.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=__NODE_BIN__ __ROOT__/server/dist/server/src/reentry-worker.js
Environment=NODE_ENV=production
Environment=PATH=__NODE_DIR__:%h/.grok/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Each model attempt is bounded to five minutes in the worker.
TimeoutStartSec=20min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
